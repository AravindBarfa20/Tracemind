# ============================================================
# Tracemind — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env

# -------------------- Application --------------------
APP_NAME=Tracemind
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
BACKEND_PORT=8000
FRONTEND_PORT=5173

# -------------------- Database (PostgreSQL) --------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=tracemind
POSTGRES_USER=tracemind
POSTGRES_PASSWORD=tracemind_dev_password
DATABASE_URL=postgresql+asyncpg://tracemind:tracemind_dev_password@localhost:5432/tracemind

# -------------------- Cache (Redis) --------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# -------------------- Authentication (JWT) --------------------
SECRET_KEY=change-this-to-a-random-secret-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# -------------------- LLM Provider --------------------
# Options: ollama, groq, openai_compat
LLM_PROVIDER=ollama

# Ollama (default — local inference)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Groq (optional — cloud inference, fast)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# OpenAI-compatible (optional — any provider)
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=

# -------------------- CORS --------------------
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
