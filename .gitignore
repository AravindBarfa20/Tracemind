# ============================================================
# Tracemind — .gitignore
# ============================================================

# -------------------- Python --------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
*.egg
dist/
build/
.eggs/
*.whl

# Virtual environments
.venv/
venv/
env/
ENV/

# Poetry
poetry.lock

# pytest
.pytest_cache/
htmlcov/
.coverage
.coverage.*
coverage.xml

# mypy
.mypy_cache/

# ruff
.ruff_cache/

# -------------------- Node --------------------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build output
frontend/dist/
frontend/build/

# -------------------- Environment --------------------
.env
.env.local
.env.*.local
!.env.example

# -------------------- IDE --------------------
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# -------------------- Docker --------------------
docker-data/

# -------------------- Misc --------------------
*.log
tmp/
temp/
.cache/
